{
  "name": "project-garden",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "build": "bun run build:server && bun run build:client",
    "build:server": "bun build ./server/src/index.ts --target=bun --outfile=./server/dist/index.js && bun build ./scripts/backup.ts ./scripts/restore.ts ./scripts/analytics.ts --target=bun --outdir=./server/dist/scripts",
    "build:client": "bun ./client/build.mjs",
    "start": "bun server/dist/index.js",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "backup": "bun scripts/backup.ts",
    "restore": "bun scripts/restore.ts",
    "analytics": "bun scripts/analytics.ts",
    "test:ui": "NODE_ENV=test bun scripts/acceptance-server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "stripe": "23.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3",
    "@tailwindcss/cli": "4.1.13"
  }
}
