PORT=3000
APP_MODE=testing
DATABASE_PATH=./data/testing/garden.db
# Reference of a NEW Supabase project reserved for testers.
TESTING_SUPABASE_PROJECT_REF=your-testing-project-ref
SUPABASE_URL=https://your-testing-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Optional: comma-separated browser origins when the client is hosted separately.
APP_ORIGIN=
# Same-origin frontend URL; use localhost only with Stripe test mode.
PUBLIC_APP_URL=http://localhost:3000
# Optional legacy SaaS billing, ignored entirely when APP_MODE=testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=
ALLOW_LIVE_BILLING=false
# Private, independently stored S3-compatible backups.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=garden-testing
